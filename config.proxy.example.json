{
  "http_address": ":8080",
  "http_body_limit": 1073741824,
  "storage_address": "127.0.0.1:8080",
  "admin_token": "dev-admin-token",
  "api_token": "dev-api-token",
  "metadata_backend": "sqlite",
  "metadata_dsn": "./data/maxio.db",
  "metadata_auto_migrate": true,
  "enable_s3_proxy": true,
  "s3_proxy_entrypoint": ":8080",
  "s3_proxy_admin_address": ":19090",
  "s3_proxy_health_interval": "5s",
  "s3_proxy_health_timeout": "2s",
  "s3_proxy_upstreams": [
    {
      "name": "local-minio",
      "endpoint": "http://127.0.0.1:9000",
      "region": "us-east-1",
      "bucket": "maxio",
      "prefix": "",
      "access_key_env": "MAXIO_UPSTREAM_ACCESS_KEY",
      "secret_key_env": "MAXIO_UPSTREAM_SECRET_KEY",
      "dedupe_mode": "observe",
      "index_mode": "content"
    }
  ],
  "data_dir": "./data",
  "log_level": "info",
  "pending_object_ttl": "1h",
  "repair_interval": "10m",
  "repair_on_start": true,
  "repair_max_batch": 100,
  "repair_max_retries": 2,
  "repair_rate_limit": 0,
  "repair_retry_backoff": "1s",
  "repair_retry_max_backoff": "10s",
  "repair_retry_multiplier": 2,
  "dedupe_interval": "30m",
  "dedupe_on_start": true,
  "dedupe_max_fixes": 100,
  "index_timeout": "30s",
  "index_retry_backoff": "1s",
  "index_max_retries": 2,
  "index_queue_size": 1024,
  "index_rate_limit": 0
}
